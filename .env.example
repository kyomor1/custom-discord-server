# 404Cord server — environment variables
# Copy this file to ".env" and fill in real values for local development.
# NEVER commit a real .env with secrets. On Render, set these under: Service → Environment.

# REQUIRED. Secret used to sign and verify JWT auth tokens.
# The server now REFUSES TO START if this is unset (no hardcoded fallback anymore).
# Generate a strong random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional. HTTP port the server listens on (default: 3001).
PORT=3001

# Optional. Prisma / SQLite database URL (default: file:./dev.db).
DATABASE_URL=file:./dev.db

# Optional. Only required if the AI assistant feature is enabled.
GEMINI_API_KEY=

# HOW THESE ARE LOADED:
#  - Local dev: src/load-env.ts (a tiny zero-dependency loader imported first in
#    index.ts) reads this .env file automatically when you run "npm run dev".
#  - Render / production: set these in the dashboard (Service -> Environment).
#    Real environment variables always take precedence over this .env file.
